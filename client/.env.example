# ─── Variáveis do frontend (build-time, prefixo VITE_) ───
# Definir no Vercel: Project → Settings → Environment Variables
# A ANON KEY é pública — pode ir no frontend sem problema.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=anon_public_key
VITE_SUPABASE_BUCKET=project-images
