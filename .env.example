# ─── Variáveis do servidor (funções serverless) ───
# Definir no Vercel: Project → Settings → Environment Variables

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_secreta_NUNCA_no_frontend
SUPABASE_BUCKET=project-images

# Autenticação do admin (login do painel)
ADMIN_EMAIL=admin@domdotdevelopments.com
ADMIN_PASSWORD=troca-esta-password
JWT_SECRET=troca-por-um-valor-aleatorio-longo

# Opcional: restringir CORS (por defeito permite todas as origens)
# CORS_ORIGIN=https://domdotdevelopments.vercel.app
